{
  "name": "souqna",
  "version": "0.1.0",
  "description": "Souqna (سوقنا) — a trust-first classifieds marketplace for Saudi Arabia",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings server/index.js",
    "seed": "node --experimental-sqlite --no-warnings server/seed.js",
    "test": "node --experimental-sqlite --no-warnings --test test/*.test.js",
    "build:demo": "node scripts/build-demo.js"
  },
  "devDependencies": {
    "sql.js": "1.14.2"
  }
}
